# Anthropic API key — create at https://console.claude.com (add billing/credits)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# The passphrase you type to unlock the app
APP_PASSPHRASE=pick-a-strong-passphrase

# Any long random string — the value stored in your auth cookie.
# Generate with:  openssl rand -hex 32
AUTH_TOKEN=replace-with-a-long-random-string

# Upstash Redis (free) — from your Upstash console, "REST API" section
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
