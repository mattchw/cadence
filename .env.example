# Google OAuth: create a Web application client in Google Cloud.
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
# For local development also add: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of THIS deployment. Use http://localhost:3000 locally.
NEXTAUTH_URL=http://localhost:3000
# Generate once with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Required database: Vercel integration provides these names.
# Use the read/write REST token, not KV_REST_API_READ_ONLY_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for AI lessons and feedback.
ANTHROPIC_API_KEY=

# Optional one-time migration of the OLD shared database records.
# Set to the original owner's Google email, import from the account panel,
# then remove this variable. Imports only work into an empty account.
# LEGACY_OWNER_EMAIL=
